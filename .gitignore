# Datasets and raw audio files
LA/
for-2seconds/
*.flac
*.wav
*.mp3

# Manifest and cache data (keep instructions/README)
data/*
!data/README.md
**/data/*
!**/data/README.md

# Reports, PPT Images, and Build Scripts (not part of core code & results)
reports/
REPORT_AND_PPT_IMAGES/
build_scripts/

# Python Virtual Environments, caches & packages
venv/
env/
.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
**/.pytest_cache/

# Environment, secrets & logs
.env
*.env
*.env.*
*.log
**/*.log

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Archives and temporary files
*.zip
*.tar.gz
*.rar
*.7z

# Word documents, presentations, and evaluation rubrics
*.docx
*.pptx

# LaTeX auxiliary files
reports/*.aux
reports/*.log
reports/*.out
reports/*.toc
reports/*.bbl
reports/*.blg
reports/*.synctex.gz
